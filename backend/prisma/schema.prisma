generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  SINDICO
  ESTOQUISTA
  CONDOMINO
  VISITANTE
}

model Usuario {
  id                    String    @id @default(cuid())
  numeroUsuario         String    @unique
  googleId              String?   @unique
  email                 String?   @unique
  emailContato          String
  telefone              String?   @unique
  senhaHash             String?
  deveTrocarSenha       Boolean   @default(true)
  resetToken            String?
  resetTokenExpiresAt   DateTime?
  nome                  String
  perfil                Perfil    @default(CONDOMINO)
  unidadeId             String?
  unidade               Unidade?  @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  compras               Compra[]
  excluidoEm            DateTime?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt
}

model Auditoria {
  id         String   @id @default(cuid())
  acao       String
  detalhes   String?
  usuarioId  String?
  usuarioNome String?
  ipAddress  String?
  criadoEm   DateTime @default(now())
}

model Unidade {
  id         String            @id @default(cuid())
  numero     String
  bloco      String            @default("")
  moradores  Usuario[]
  compras    Compra[]
  relatorios RelatorioMensal[]
  criadoEm   DateTime          @default(now())

  @@unique([numero, bloco])
}

model ItemEstoque {
  id         String   @id @default(cuid())
  nome       String
  categoria  String
  quantidade Int      @default(0)
  preco      Decimal  @db.Decimal(10, 2)
  ativo      Boolean  @default(true)
  compras    Compra[]
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([nome])
  @@index([categoria, ativo])
}

model Compra {
  id         String     @id @default(cuid())
  usuarioId  String
  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  unidadeId  String?
  unidade    Unidade?   @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  itemId     String
  item       ItemEstoque @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantidade Int
  valor      Decimal    @db.Decimal(10, 2)
  data       DateTime   @default(now())

  @@index([usuarioId, data])
  @@index([unidadeId, data])
}

model RelatorioMensal {
  id        String   @id @default(cuid())
  unidadeId String
  unidade   Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  mes       Int
  ano       Int
  valorTotal Decimal @default(0) @db.Decimal(12, 2)
  geradoEm  DateTime @updatedAt

  @@unique([unidadeId, ano, mes])
  @@index([ano, mes])
}
