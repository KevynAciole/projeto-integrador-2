    { "source": "/estoque/:path*", "destination": "https://projeto-integrador-2-production-96ba.up.railway.app/estoque/:path*" },
    { "source": "/usuarios", "destination": "https://projeto-integrador-2-production-96ba.up.railway.app/usuarios" },
