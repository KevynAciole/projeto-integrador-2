{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace @minimercado/backend"
  },
  "deploy": {
    "startCommand": "npm run db:deploy --workspace @minimercado/backend && npm start --workspace @minimercado/backend",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}